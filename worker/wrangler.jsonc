{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yapso-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "vars": {
    // Swap models here without an app update.
    "OPENAI_MODEL": "gpt-5.6-luna",
    "OPENAI_REASONING": "low",
    "DEEPGRAM_MODEL": "nova-3",
    // Per device per UTC day.
    "DEVICE_DAILY_TRANSCRIBE": "15",
    "DEVICE_DAILY_FEEDBACK": "12",
    // Across all devices per UTC day: a backstop on spend until App Attest is in.
    "GLOBAL_DAILY_TRANSCRIBE": "2000",
    "GLOBAL_DAILY_FEEDBACK": "2000"
  },
  "kv_namespaces": [{ "binding": "LIMITS", "id": "0f9429c1392f450887b102b9c50e0571" }],
  "ratelimits": [{ "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
  // Secrets (wrangler secret put / .dev.vars): OPENAI_API_KEY, DEEPGRAM_API_KEY
}
